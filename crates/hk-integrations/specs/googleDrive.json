{
 "name": "googleDrive",
 "type": "n8n-nodes-base.googleDrive",
 "display": "Google Drive",
 "description": "Search, organize and share files (no upload/download yet)",
 "color": "#4285F4",
 "versions": [
  1,
  2,
  3
 ],
 "base": "https://www.googleapis.com/drive/v3",
 "cred": {
  "name": "googleDriveOAuth2Api",
  "display": "Google Drive OAuth2 API",
  "oauth": {
   "token_url": "https://oauth2.googleapis.com/token",
   "scope": "https://www.googleapis.com/auth/drive",
   "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
   "auth_params": "access_type=offline&prompt=consent"
  },
  "docs": "https://console.cloud.google.com/apis/credentials (OAuth client of type Desktop app; add http://127.0.0.1:53682/callback if asked), then press Sign in"
 },
 "resources": [
  {
   "name": "file",
   "display": "File",
   "ops": [
    {
     "name": "list",
     "display": "Search",
     "method": "GET",
     "path": "/files",
     "action": "Search files",
     "extra": [
      {
       "name": "q",
       "display": "Query",
       "send": "query",
       "desc": "Drive query, e.g. name contains 'report' and trashed = false"
      }
     ],
     "qs": {
      "fields": "nextPageToken,files(id,name,mimeType,modifiedTime,parents,size,webViewLink)"
     },
     "out": "files",
     "list": true,
     "page": {
      "type": "cursor",
      "cursorParam": "pageToken",
      "nextPath": "nextPageToken",
      "pageSize": 1000,
      "sizeParam": "pageSize"
     }
    },
    {
     "name": "get",
     "display": "Get",
     "method": "GET",
     "path": "/files/{fileId}",
     "action": "Get file metadata",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      }
     ],
     "qs": {
      "fields": "*"
     }
    },
    {
     "name": "copy",
     "display": "Copy",
     "method": "POST",
     "path": "/files/{fileId}/copy",
     "action": "Copy a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      }
     ],
     "extra": [
      {
       "name": "name",
       "display": "Name",
       "send": "body"
      }
     ]
    },
    {
     "name": "update",
     "display": "Update",
     "method": "PATCH",
     "path": "/files/{fileId}",
     "action": "Rename a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      },
      {
       "name": "name",
       "display": "New Name",
       "required": true,
       "send": "body"
      }
     ]
    },
    {
     "name": "move",
     "display": "Move",
     "method": "PATCH",
     "path": "/files/{fileId}",
     "action": "Move a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      },
      {
       "name": "addParents",
       "display": "New Folder ID",
       "required": true,
       "send": "query"
      },
      {
       "name": "removeParents",
       "display": "Old Folder ID",
       "send": "query"
      }
     ]
    },
    {
     "name": "delete",
     "display": "Delete",
     "method": "DELETE",
     "path": "/files/{fileId}",
     "action": "Delete a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      }
     ]
    },
    {
     "name": "download",
     "display": "Download",
     "method": "GET",
     "path": "/files/{fileId}",
     "action": "Download a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      }
     ],
     "qs": {
      "alt": "media"
     },
     "download": true
    },
    {
     "name": "export",
     "display": "Export (Docs, Sheets, Slides)",
     "method": "GET",
     "path": "/files/{fileId}/export",
     "action": "Export a Google file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      },
      {
       "name": "mimeType",
       "display": "Export As",
       "required": true,
       "send": "query",
       "default": "application/pdf"
      }
     ],
     "download": true
    },
    {
     "name": "upload",
     "display": "Upload",
     "method": "POST",
     "path": "https://www.googleapis.com/upload/drive/v3/files",
     "action": "Upload a file",
     "params": [
      {
       "name": "name",
       "display": "File Name",
       "required": true,
       "send": "body"
      }
     ],
     "extra": [
      {
       "name": "parents",
       "display": "Parent Folder IDs (JSON array)",
       "type": "json",
       "send": "body"
      }
     ],
     "qs": {
      "uploadType": "multipart"
     },
     "upload": true,
     "multipart": true
    },
    {
     "name": "share",
     "display": "Share",
     "method": "POST",
     "path": "/files/{fileId}/permissions",
     "action": "Share a file",
     "params": [
      {
       "name": "fileId",
       "display": "File ID",
       "required": true
      },
      {
       "name": "role",
       "display": "Role",
       "required": true,
       "send": "body",
       "default": "reader"
      },
      {
       "name": "type",
       "display": "Type",
       "required": true,
       "send": "body",
       "default": "user"
      }
     ],
     "extra": [
      {
       "name": "emailAddress",
       "display": "Email",
       "send": "body"
      },
      {
       "name": "domain",
       "display": "Domain",
       "send": "body"
      }
     ]
    }
   ]
  },
  {
   "name": "folder",
   "display": "Folder",
   "ops": [
    {
     "name": "create",
     "display": "Create",
     "method": "POST",
     "path": "/files",
     "action": "Create a folder",
     "params": [
      {
       "name": "name",
       "display": "Name",
       "required": true,
       "send": "body"
      }
     ],
     "extra": [
      {
       "name": "parents",
       "display": "Parent Folder IDs (JSON array)",
       "type": "json",
       "send": "body"
      }
     ],
     "body": {
      "mimeType": "application/vnd.google-apps.folder"
     }
    },
    {
     "name": "delete",
     "display": "Delete",
     "method": "DELETE",
     "path": "/files/{folderId}",
     "action": "Delete a folder",
     "params": [
      {
       "name": "folderId",
       "display": "Folder ID",
       "required": true
      }
     ]
    }
   ]
  }
 ]
}
