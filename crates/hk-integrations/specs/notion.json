{
 "name": "notion",
 "type": "n8n-nodes-base.notion",
 "display": "Notion",
 "description": "Pages, databases and blocks in Notion",
 "color": "#000000",
 "icon": "file:notion.svg",
 "versions": [
  1,
  2,
  2.1,
  2.2
 ],
 "base": "https://api.notion.com/v1",
 "headers": {
  "Notion-Version": "2022-06-28"
 },
 "cred": {
  "name": "notionApi",
  "display": "Notion API",
  "docs": "https://developers.notion.com/docs/authorization",
  "fields": [
   {
    "name": "apiKey",
    "display": "Internal Integration Secret",
    "secret": true,
    "required": true
   }
  ],
  "auth": {
   "header": {
    "Authorization": "=Bearer {{$credentials.apiKey}}"
   }
  },
  "test": "/users/me"
 },
 "resources": [
  {
   "name": "page",
   "display": "Page",
   "ops": [
    {
     "name": "get",
     "display": "Get",
     "action": "Get a page",
     "method": "GET",
     "path": "/pages/{pageId}",
     "params": [
      {
       "name": "pageId",
       "display": "Page ID",
       "required": true
      }
     ]
    },
    {
     "name": "create",
     "display": "Create",
     "action": "Create a page",
     "method": "POST",
     "path": "/pages",
     "params": [
      {
       "name": "parentId",
       "display": "Parent Database ID",
       "required": true,
       "send": "body",
       "prop": "parent.database_id"
      },
      {
       "name": "properties",
       "display": "Properties (JSON)",
       "type": "json",
       "send": "body"
      }
     ],
     "extra": [
      {
       "name": "children",
       "display": "Content Blocks (JSON array)",
       "type": "json",
       "send": "body"
      }
     ]
    },
    {
     "name": "update",
     "display": "Update",
     "action": "Update a page",
     "method": "PATCH",
     "path": "/pages/{pageId}",
     "params": [
      {
       "name": "pageId",
       "display": "Page ID",
       "required": true
      },
      {
       "name": "properties",
       "display": "Properties (JSON)",
       "type": "json",
       "send": "body"
      }
     ],
     "extra": [
      {
       "name": "archived",
       "display": "Archived",
       "type": "boolean",
       "send": "body"
      }
     ]
    }
   ]
  },
  {
   "name": "database",
   "display": "Database",
   "ops": [
    {
     "name": "get",
     "display": "Get",
     "action": "Get a database",
     "method": "GET",
     "path": "/databases/{databaseId}",
     "params": [
      {
       "name": "databaseId",
       "display": "Database ID",
       "required": true
      }
     ]
    },
    {
     "name": "search",
     "display": "Search",
     "action": "Search databases",
     "method": "POST",
     "path": "/search",
     "body": {
      "filter": {
       "property": "object",
       "value": "database"
      }
     },
     "out": "results",
     "list": true,
     "page": {
      "type": "cursor",
      "cursorParam": "start_cursor",
      "nextPath": "next_cursor",
      "pageSize": 100,
      "sizeParam": "page_size",
      "inBody": true
     },
     "extra": [
      {
       "name": "query",
       "display": "Search Text",
       "send": "body"
      }
     ]
    }
   ]
  },
  {
   "name": "databasePage",
   "display": "Database Page",
   "ops": [
    {
     "name": "getAll",
     "display": "Get Many",
     "action": "Query a database",
     "method": "POST",
     "path": "/databases/{databaseId}/query",
     "params": [
      {
       "name": "databaseId",
       "display": "Database ID",
       "required": true
      }
     ],
     "out": "results",
     "list": true,
     "page": {
      "type": "cursor",
      "cursorParam": "start_cursor",
      "nextPath": "next_cursor",
      "pageSize": 100,
      "sizeParam": "page_size",
      "inBody": true
     },
     "extra": [
      {
       "name": "filter",
       "display": "Filter (JSON)",
       "type": "json",
       "send": "body"
      },
      {
       "name": "sorts",
       "display": "Sorts (JSON array)",
       "type": "json",
       "send": "body"
      }
     ]
    }
   ]
  },
  {
   "name": "block",
   "display": "Block",
   "ops": [
    {
     "name": "getAll",
     "display": "Get Many",
     "action": "Get child blocks",
     "method": "GET",
     "path": "/blocks/{blockId}/children",
     "params": [
      {
       "name": "blockId",
       "display": "Block or Page ID",
       "required": true
      }
     ],
     "out": "results",
     "list": true,
     "page": {
      "type": "cursor",
      "cursorParam": "start_cursor",
      "nextPath": "next_cursor",
      "pageSize": 100,
      "sizeParam": "page_size"
     }
    },
    {
     "name": "append",
     "display": "Append After",
     "action": "Append blocks",
     "method": "PATCH",
     "path": "/blocks/{blockId}/children",
     "params": [
      {
       "name": "blockId",
       "display": "Block or Page ID",
       "required": true
      },
      {
       "name": "children",
       "display": "Blocks (JSON array)",
       "type": "json",
       "send": "body",
       "required": true
      }
     ]
    }
   ]
  },
  {
   "name": "user",
   "display": "User",
   "ops": [
    {
     "name": "getAll",
     "display": "Get Many",
     "action": "List users",
     "method": "GET",
     "path": "/users",
     "out": "results",
     "list": true,
     "page": {
      "type": "cursor",
      "cursorParam": "start_cursor",
      "nextPath": "next_cursor",
      "pageSize": 100,
      "sizeParam": "page_size"
     }
    }
   ]
  }
 ]
}